<header class="site-header">
  <!-- Masthead Top Utility Bar -->
  <div class="masthead-top-bar">
    <div class="container masthead-top-inner">
      <div class="masthead-top-left">
        <span class="masthead-issue-badge"><%= siteConfig.volume || 'Vol. I • Est. 2026' %></span>
        <span class="masthead-top-divider">/</span>
        <span class="masthead-top-date" id="masthead-live-date">Nagpur & Nanded, Maharashtra</span>
      </div>
      <div class="masthead-top-right">
        <a href="<%= siteConfig.instagramUrl %>" target="_blank" rel="noopener noreferrer" class="masthead-ig-pill" title="Follow @eureka.discoveries on Instagram">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>Instagram: <strong>@eureka.discoveries</strong></span>
        </a>
      </div>
    </div>
  </div>

  <div class="container header-inner">
    <a href="/" class="brand-logo" aria-label="EUREKA Homepage">
      <div class="brand-emblem">
        <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="var(--color-foreground)" />
          <!-- Architectural Greek/Editorial E -->
          <path d="M9 8.5H23M9 16H19.5M9 23.5H23" stroke="var(--color-background)" stroke-width="2.6" stroke-linecap="square" />
          <circle cx="23" cy="16" r="2" fill="var(--color-accent)" />
        </svg>
      </div>
      <div class="brand-text-group">
        <span class="brand-title">EUREKA</span>
        <span class="brand-sub">COGNITIVE SCIENCE & BEHAVIOR</span>
      </div>
    </a>

    <nav aria-label="Primary Navigation">
      <ul class="nav-links">
        <% siteConfig.navItems.forEach(item => { %>
          <% if (!item.isAction) { %>
            <li>
              <a href="<%= item.path %>" class="nav-link <%= activePath === item.path ? 'active' : '' %>">
                <%= item.label %>
              </a>
            </li>
          <% } %>
        <% }) %>
      </ul>
    </nav>

    <div class="header-controls">
      <!-- Search Trigger -->
      <button class="search-trigger-btn" aria-label="Open search dialog">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-btn-text">Search</span>
        <span class="kbd-shortcut">⌘K</span>
      </button>

      <!-- Saved Reading List Button -->
      <button id="reading-list-toggle" class="reading-list-btn" aria-label="Open Saved Reading List" title="Open your saved reading list">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
        <span class="reading-list-btn-text">Saved</span>
        <span id="saved-count-badge" class="saved-badge">0</span>
      </button>

      <!-- Instagram Direct Channel Link -->
      <a href="<%= siteConfig.instagramUrl %>" target="_blank" rel="noopener noreferrer" class="header-ig-link" title="Follow @eureka.discoveries on Instagram">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>

      <a href="/editor" class="nav-action-btn" title="Write in Eureka Studio">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        <span class="nav-action-text">Studio</span>
      </a>

      <!-- Mobile Hamburger Menu Button -->
      <button id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-nav-overlay" class="mobile-nav-overlay" aria-hidden="true"></div>
<aside id="mobile-nav-drawer" class="mobile-nav-drawer" aria-label="Mobile Navigation" aria-hidden="true">
  <div class="mobile-drawer-header">
    <div class="brand-text-group">
      <span class="brand-title" style="font-size: 1.15rem;">EUREKA</span>
      <span class="brand-sub" style="font-size: 0.58rem;">COGNITIVE SCIENCE & BEHAVIOR</span>
    </div>
    <button id="mobile-nav-close" class="mobile-nav-close-btn" aria-label="Close navigation menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="mobile-drawer-body">
    <!-- Mobile Instagram Banner -->
    <a href="<%= siteConfig.instagramUrl %>" target="_blank" rel="noopener noreferrer" class="mobile-ig-banner">
      <div class="mobile-ig-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </div>
      <div class="mobile-ig-text">
        <strong>@eureka.discoveries</strong>
        <span>Follow our visual science channel →</span>
      </div>
    </a>

    <div class="mobile-nav-section-title">Navigation</div>
    <ul class="mobile-nav-list">
      <li><a href="/" class="mobile-nav-item <%= activePath === '/' ? 'active' : '' %>">All Essays</a></li>
      <li><a href="/about" class="mobile-nav-item <%= activePath === '/about' ? 'active' : '' %>">About EUREKA</a></li>
      <li><a href="/editor" class="mobile-nav-item <%= activePath === '/editor' ? 'active' : '' %>">Author Studio</a></li>
      <li><a href="/contact" class="mobile-nav-item <%= activePath === '/contact' ? 'active' : '' %>">Editorial Desk & Office</a></li>
      <li><a href="/rss.xml" class="mobile-nav-item" target="_blank" rel="noopener">RSS Feed</a></li>
    </ul>

    <% if (siteConfig.categories && siteConfig.categories.length > 0) { %>
      <div class="mobile-nav-section-title" style="margin-top: 1.5rem;">Explore Topics</div>
      <ul class="mobile-nav-list">
        <% siteConfig.categories.forEach(cat => { %>
          <li>
            <a href="/category/<%= encodeURIComponent(cat.slug) %>" class="mobile-nav-item <%= activePath === '/category/' + cat.slug ? 'active' : '' %>">
              <span class="mobile-cat-dot" style="background-color: <%= cat.color || 'var(--color-accent)' %>;"></span>
              <%= cat.name %>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="mobile-drawer-footer">
    <div style="font-size: var(--text-xs); color: var(--color-muted-foreground); margin-bottom: 8px; line-height: 1.5;">
      Engineered by <strong><%= siteConfig.engineeredBy %></strong><br>
      Researched by <strong><%= siteConfig.researchedAndWrittenBy %></strong>
    </div>
    <div style="font-size: 0.72rem; color: var(--color-muted-foreground);">
      © <%= new Date().getFullYear() %> EUREKA. All rights reserved.
    </div>
  </div>
</aside>

<!-- Saved Reading List Slide-Over Drawer -->
<div id="reading-list-overlay" class="reading-list-overlay" aria-hidden="true"></div>
<aside id="reading-list-drawer" class="reading-list-drawer" aria-label="Saved Reading List" aria-hidden="true">
  <div class="reading-list-header">
    <div style="display: flex; align-items: center; gap: 8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent);">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>
      <h3 style="font-family: var(--font-sans); font-size: 1.05rem; font-weight: 700; margin: 0;">Reading List</h3>
    </div>
    <button id="reading-list-close" class="reading-list-close-btn" aria-label="Close saved reading list">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="reading-list-body" id="reading-list-container">
    <div class="reading-list-empty">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-muted-foreground); margin-bottom: 8px;">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>
      <p style="font-size: var(--text-sm); color: var(--color-muted-foreground); margin: 0;">
        No saved essays yet. Click the bookmark icon on any article to save it for reading later.
      </p>
    </div>
  </div>

  <div class="reading-list-footer">
    <button id="reading-list-clear-btn" class="reading-list-clear-btn" type="button">Clear All</button>
  </div>
</aside>
