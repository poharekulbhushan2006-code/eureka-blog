<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-logo" aria-label="EUREKA Homepage">
      <div class="brand-emblem">
        <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="emblem-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#7c3aed" />
              <stop offset="50%" stop-color="#a855f7" />
              <stop offset="100%" stop-color="#ec4899" />
            </linearGradient>
          </defs>
          <rect width="36" height="36" rx="9" fill="url(#emblem-grad)" opacity="0.16" />
          <rect x="0.75" y="0.75" width="34.5" height="34.5" rx="8.25" stroke="url(#emblem-grad)" stroke-width="1.5" />
          <!-- Architectural E lines -->
          <path d="M10 10.5H21M10 18H18M10 25.5H21" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <!-- Dynamic K-A Spark -->
          <path d="M22 13L26 18L22 23" stroke="#ec4899" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="26" cy="18" r="1.8" fill="#ec4899" />
        </svg>
      </div>
      <div class="brand-text-group">
        <span class="brand-title">EURE<span class="brand-highlight">KA</span></span>
        <span class="brand-sub">JOURNAL OF IDEAS</span>
      </div>
    </a>

    <nav aria-label="Primary Navigation">
      <ul class="nav-links">
        <% siteConfig.navItems.forEach(item => { %>
          <% if (!item.isAction) { %>
            <li>
              <a href="<%= item.path %>" class="nav-link <%= activePath === item.path ? 'active' : '' %>">
                <%= item.label %>
              </a>
            </li>
          <% } %>
        <% }) %>
      </ul>
    </nav>

    <div class="header-controls">
      <button class="search-trigger-btn" aria-label="Open search dialog">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-btn-text">Search</span>
        <span class="kbd-shortcut">⌘K</span>
      </button>

      <button id="theme-toggle-btn" class="theme-toggle-btn" aria-label="Toggle theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a href="/editor" class="nav-action-btn" title="Write in Eureka Studio">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        <span class="nav-action-text">Write</span>
      </a>
    </div>
  </div>
</header>
