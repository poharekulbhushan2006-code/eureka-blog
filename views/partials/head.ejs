<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'EUREKA — Understanding How We Think, Feel, and Behave' %></title>
  <meta name="description" content="<%= description || 'Psychology, human behavior, relationships, decision-making, and the patterns that shape everyday life — explained clearly and thoughtfully.' %>">
  <meta name="author" content="EUREKA Editorial">
  <meta name="robots" content="index, follow">

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : 'https://eureka-journal.org' + (typeof activePath !== 'undefined' ? activePath : '') %>">
  <link rel="alternate" type="application/rss+xml" title="EUREKA — Journal of Ideas RSS Feed" href="/rss.xml">

  <!-- Favicon Set -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">

  <!-- OpenGraph / Facebook / LinkedIn -->
  <meta property="og:site_name" content="EUREKA Journal of Ideas">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="<%= typeof pageType !== 'undefined' && pageType === 'post' ? 'article' : 'website' %>">
  <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : 'https://eureka-journal.org' + (typeof activePath !== 'undefined' ? activePath : '') %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/images/og-eureka-cover.jpg' %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/images/og-eureka-cover.jpg' %>">

  <!-- Core Design System CSS -->
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/animations.css">

  <!-- Early Theme Initialization to Prevent Flash of Unstyled Content (FOUC) -->
  <script>
    (function() {
      var saved = localStorage.getItem('eureka-theme');
      var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body data-page="<%= typeof pageType !== 'undefined' ? pageType : 'default' %>" data-topic="<%= typeof topic !== 'undefined' ? topic : 'default' %>">
  <!-- Top Navigation & Page Loading Bar -->
  <div id="page-nav-loader" class="page-nav-loader" aria-hidden="true">
    <div class="nav-loader-bar"></div>
  </div>

  <!-- Reading Progress Bar -->
  <div id="reading-progress-container">
    <div id="reading-progress-bar"></div>
  </div>

  <!-- Website Opening Intro Animation (Smooth Splash Reveal) -->
  <div id="site-intro-overlay" class="site-intro-overlay" aria-hidden="true">
    <div class="intro-content">
      <div class="intro-logo-mark">
        <svg width="56" height="56" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="6" fill="var(--color-primary)" />
          <path d="M9 8.5H23M9 16H19.5M9 23.5H23" stroke="var(--color-background)" stroke-width="2.6" stroke-linecap="square" />
          <circle cx="23" cy="16" r="2" fill="var(--color-accent)" />
        </svg>
      </div>
      <div class="intro-brand">
        <span class="intro-letter" style="--i: 0">E</span>
        <span class="intro-letter" style="--i: 1">U</span>
        <span class="intro-letter" style="--i: 2">R</span>
        <span class="intro-letter" style="--i: 3">E</span>
        <span class="intro-letter intro-highlight" style="--i: 4">K</span>
        <span class="intro-letter intro-highlight" style="--i: 5">A</span>
      </div>
      <p class="intro-tagline">Understanding how we think, feel, and behave.</p>
      <div class="intro-loader-line">
        <div class="intro-loader-progress"></div>
      </div>
    </div>
  </div>

  <!-- Dynamic Topic-Aware Canvas Engine -->
  <canvas id="dynamic-bg-canvas" class="dynamic-bg-canvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -2;" aria-hidden="true"></canvas>

  <!-- Ambient EUREKA Background Kinetic Watermark -->
  <div id="eureka-ambient-bg" class="eureka-ambient-bg" aria-hidden="true">
    <div class="eureka-bg-letters">
      <span class="bg-letter" style="--i: 0">E</span>
      <span class="bg-letter" style="--i: 1">U</span>
      <span class="bg-letter" style="--i: 2">R</span>
      <span class="bg-letter" style="--i: 3">E</span>
      <span class="bg-letter bg-letter-highlight" style="--i: 4">K</span>
      <span class="bg-letter bg-letter-highlight" style="--i: 5">A</span>
    </div>
  </div>

  <%- include('header') %>
