<%- include('../partials/head') %>

<!-- Link Article Styles -->
<link rel="stylesheet" href="/css/article.css">

<main class="article-page-main">
  <!-- Authoritative Left-Aligned Editorial Article Header -->
  <header class="article-header">
    <div class="container article-header-container">
      <!-- Breadcrumb Bar -->
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Eureka</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/category/<%= encodeURIComponent(post.category) %>"><%= post.category %></a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">Essay</span>
      </nav>

      <div class="article-kicker">
        <span class="badge badge-accent"><%= post.category %></span>
        <span class="kicker-sep">•</span>
        <span class="kicker-item"><%= post.readingTime %></span>
        <span class="kicker-sep">•</span>
        <span class="kicker-item"><%= post.publishedAt %></span>
      </div>

      <h1 class="article-headline"><%= post.title %></h1>

      <% if (post.subtitle) { %>
        <p class="article-deck"><%= post.subtitle %></p>
      <% } %>

    </div>
  </header>

  <!-- Article Layout: Left Sidebar (TOC + Other Topics) + Main Reading Container -->
  <div class="article-layout-wrapper">
    
    <!-- Left Sticky Sidebar -->
    <aside class="article-sidebar-left" aria-label="Reading tools and related topics">
      <div class="sidebar-sticky-inner">
        
        <!-- Interactive Dynamic Table of Contents -->
        <div id="table-of-contents-box" class="toc-sidebar-box">
          <div class="toc-header">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="21" y1="10" x2="7" y2="10"></line>
              <line x1="21" y1="6" x2="3" y2="6"></line>
              <line x1="21" y1="14" x2="3" y2="14"></line>
              <line x1="21" y1="18" x2="7" y2="18"></line>
            </svg>
            <span>TABLE OF CONTENTS</span>
          </div>
          <nav id="toc-nav-list" class="toc-nav-list" aria-label="Table of Contents Links">
            <!-- Dynamically populated by JS from h2 and h3 elements -->
          </nav>
        </div>

        <!-- Instagram Channel Highlight Widget -->
        <div class="sidebar-ig-card">
          <div class="sidebar-ig-head">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <strong>@eureka.discoveries</strong>
          </div>
          <p class="sidebar-ig-text">
            Explore daily visual summaries & cognitive maps for this topic on Instagram.
          </p>
          <a href="<%= siteConfig.instagramUrl %>" target="_blank" rel="noopener noreferrer" class="sidebar-ig-link">
            Open Channel →
          </a>
        </div>

        <!-- Other Topics / Further Dispatches -->
        <% if (typeof otherPosts !== 'undefined' && otherPosts && otherPosts.length > 0) { %>
          <div class="other-topics-section">
            <div class="sidebar-header">
              <span class="sidebar-dot"></span>
              <span class="sidebar-kicker">RELATED DISPATCHES</span>
            </div>

            <% otherPosts.slice(0, 2).forEach(other => { %>
              <a href="/post/<%= other.slug %>" class="other-topic-card" title="Read <%= other.title %>">
                <div class="other-topic-body">
                  <span class="badge" style="align-self: flex-start; margin-bottom: 4px;"><%= other.category %></span>
                  <h4 class="other-topic-title"><%= other.title %></h4>
                  <div class="other-topic-meta">
                    <span><%= other.readingTime %></span>
                    <span class="other-topic-arrow">Read →</span>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>

      </div>
    </aside>

    <!-- Main Reading Container -->
    <div class="article-container">
      
      <!-- Reader Display Controls Bar -->
      <div id="reader-controls-bar" class="reader-controls-bar">
        <div class="reader-control-group">
          <span class="reader-control-label">Type Size</span>
          <div class="reader-btn-group">
            <button type="button" class="reader-control-btn" data-font-size="sm" title="Compact (16px)">A-</button>
            <button type="button" class="reader-control-btn active" data-font-size="md" title="Default (18px)">A</button>
            <button type="button" class="reader-control-btn" data-font-size="lg" title="Large (20px)">A+</button>
          </div>
        </div>

        <div class="reader-control-group">
          <span class="reader-control-label">Typography</span>
          <div class="reader-btn-group">
            <button type="button" class="reader-control-btn active" data-font-family="serif" title="Newsreader Serif">Serif</button>
            <button type="button" class="reader-control-btn" data-font-family="sans" title="Modern Sans">Sans</button>
          </div>
        </div>
      </div>

      <!-- Main Prose Essay Content -->
      <article class="article-prose" id="article-prose-content">
        <%- post.renderedHtml %>
      </article>

      <!-- Clean, Professional SVG Action Bar -->
      <div class="article-actions-bar">
        <div class="action-btn-group">
          <button id="clap-btn" class="action-btn" data-slug="<%= post.slug %>" title="Applaud essay" aria-label="Applaud essay">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span class="action-btn-text">Applaud</span>
            <span id="clap-count" class="action-btn-count"><%= post.claps || 0 %></span>
          </button>

          <button id="bookmark-btn" class="action-btn" data-slug="<%= post.slug %>" data-title="<%= post.title %>" title="Save to reading list" aria-label="Save to reading list">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
            <span class="action-btn-text">Save</span>
          </button>
        </div>

        <div class="action-btn-group">
          <button id="share-btn" class="action-btn" title="Copy share link" aria-label="Share this essay">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span>Share</span>
          </button>

          <a href="<%= siteConfig.instagramUrl %>" target="_blank" rel="noopener noreferrer" class="action-btn action-btn-ig" title="View on Instagram">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>
        </div>
      </div>



      <!-- Instagram Callout Banner -->
      <div class="article-ig-banner reading-reveal">
        <div class="article-ig-banner-inner">
          <div class="article-ig-icon-wrap">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
          <div class="article-ig-info">
            <div class="article-ig-title">Continue the inquiry on Instagram</div>
            <div class="article-ig-sub">Follow <strong>@eureka.discoveries</strong> for illustrated psychology breakdowns and mental models.</div>
          </div>
          <a href="<%= siteConfig.instagramUrl %>" target="_blank" rel="noopener noreferrer" class="article-ig-cta-btn">
            Follow @eureka.discoveries ↗
          </a>
        </div>
      </div>

      <!-- Tags -->
      <% if (post.tags && post.tags.length > 0) { %>
        <div class="article-tags-row reading-reveal">
          <span class="tags-label">INDEXED TOPICS:</span>
          <% post.tags.forEach(tag => { %>
            <a href="/tag/<%= encodeURIComponent(tag) %>" class="badge">#<%= tag %></a>
          <% }) %>
        </div>
      <% } %>

    </div>
  </div>

  <!-- Related Reading Section -->
  <% if (related && related.length > 0) { %>
    <section class="related-dispatches-section reveal">
      <div class="container" style="max-width: 900px;">
        <div class="related-section-header">
          <h3 class="related-section-title">Further Inquiries & Dispatches</h3>
          <span class="related-section-rule"></span>
        </div>

        <div class="related-dispatches-grid">
          <% related.forEach(rel => { %>
            <a href="/post/<%= rel.slug %>" class="related-dispatch-card reveal">
              <span class="badge badge-accent" style="align-self: flex-start; margin-bottom: 8px;"><%= rel.category %></span>
              <h4 class="related-dispatch-title"><%= rel.title %></h4>
              <% if (rel.subtitle) { %>
                <p class="related-dispatch-excerpt"><%= rel.subtitle %></p>
              <% } %>
              <div class="related-dispatch-meta">
                <span><%= rel.readingTime %></span>
                <span class="related-dispatch-arrow">Read Essay →</span>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>
</main>

<%- include('../partials/scripts') %>
