<%- include('../partials/head') %>

<main class="home-main">
  <!-- Editorial Masthead Header Section -->
  <section class="editorial-masthead">
    <div class="container">
      <div class="masthead-intro-row">
        <div class="masthead-headline-block">
          <div class="masthead-eyebrow">
            <span>DISPATCHES ON MIND, NATURE & BEHAVIOR</span>
            <span class="masthead-eyebrow-sep">•</span>
            <span>NODE.JS EDITORIAL ENGINE</span>
          </div>
          <h1 class="masthead-headline">
            Understanding the hidden architectures behind how we think, feel, and choose.
          </h1>
          <p class="masthead-lead">
            EUREKA is an independent publication exploring cognitive biases, attachment theory, systems thinking, and scientific inquiry — articulated for clarity, depth, and practical self-awareness.
          </p>
        </div>

        <!-- Topic Quick-Chips -->
        <div class="masthead-topics-bar">
          <span class="topics-bar-label">Core Inquiries:</span>
          <div class="topics-chips-list">
            <% siteConfig.categories.slice(0, 5).forEach(cat => { %>
              <a href="/category/<%= encodeURIComponent(cat.slug) %>" class="topic-chip">
                <span class="topic-chip-dot" style="background-color: <%= cat.color || 'var(--color-accent)' %>;"></span>
                <%= cat.name %>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Broadsheet Feature Grid (Lead Story + Instagram Channel Showcase & Trending) -->
  <section class="broadsheet-grid-section">
    <div class="container">
      <div class="broadsheet-layout">
        
        <!-- Left: Grand Lead Essay -->
        <div class="broadsheet-lead-col">
          <% if (featured) { %>
            <article class="lead-story-card">
              <div class="lead-meta-row">
                <span class="badge badge-accent"><%= featured.category %></span>
                <span class="lead-meta-sep">•</span>
                <span class="lead-meta-item"><%= featured.readingTime %></span>
                <span class="lead-meta-sep">•</span>
                <span class="lead-meta-item"><%= featured.publishedAt %></span>
              </div>

              <h2 class="lead-title">
                <a href="/post/<%= featured.slug %>"><%= featured.title %></a>
              </h2>

              <p class="lead-excerpt">
                <%= featured.subtitle || featured.excerpt %>
              </p>

              <div class="lead-footer">
                <div class="lead-author-info">
                  <div class="author-avatar-chip">AM</div>
                  <div>
                    <div class="lead-author-name"><%= siteConfig.researchedAndWrittenBy %></div>
                    <div class="lead-author-role">Research Fellow & Author</div>
                  </div>
                </div>

                <a href="/post/<%= featured.slug %>" class="lead-cta-link">
                  <span>Read Full Essay</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </article>
          <% } %>
        </div>

        <!-- Right Sidebar: Instagram Channel Showcase + Trending Dispatches -->
        <aside class="broadsheet-sidebar-col">
          
          <!-- OFFICIAL INSTAGRAM CHANNEL SHOWCASE CARD -->
          <div class="instagram-showcase-card">
            <div class="ig-card-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>OFFICIAL INSTAGRAM CHANNEL</span>
            </div>

            <div class="ig-card-header">
              <div class="ig-card-avatar">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #ffffff;">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </div>
              <div>
                <h3 class="ig-channel-title">Eureka Discoveries</h3>
                <a href="<%= siteConfig.instagramUrl %>" target="_blank" rel="noopener noreferrer" class="ig-handle-link">
                  <%= siteConfig.instagramHandle || '@eureka.discoveries' %> ↗
                </a>
              </div>
            </div>

            <p class="ig-card-desc">
              Visual breakdowns of psychological experiments, behavioral economics models, and bite-sized cognitive insights published daily.
            </p>

            <div class="ig-card-tags">
              <span class="ig-tag">#MentalModels</span>
              <span class="ig-tag">#Psychology</span>
              <span class="ig-tag">#SelfAwareness</span>
            </div>

            <a href="<%= siteConfig.instagramUrl %>" target="_blank" rel="noopener noreferrer" class="ig-follow-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Follow @eureka.discoveries on Instagram</span>
            </a>
          </div>

          <!-- Trending & Curated Inquiries -->
          <div class="trending-panel">
            <div class="panel-section-title">
              <span>CURATED ESSAYS</span>
              <span class="panel-title-rule"></span>
            </div>

            <div class="trending-items-list">
              <% posts.slice(0, 3).forEach((item, index) => { %>
                <a href="/post/<%= item.slug %>" class="trending-row-item">
                  <div class="trending-idx">0<%= index + 1 %></div>
                  <div class="trending-content">
                    <span class="trending-cat"><%= item.category %></span>
                    <h4 class="trending-title"><%= item.title %></h4>
                    <span class="trending-meta"><%= item.readingTime %></span>
                  </div>
                </a>
              <% }) %>
            </div>
          </div>

        </aside>
      </div>
    </div>
  </section>

  <!-- Dispatches Feed Section -->
  <section id="articles" class="dispatches-section">
    <div class="container">
      <div class="dispatches-header-row">
        <div>
          <h2 class="dispatches-heading">All Dispatches & Essays</h2>
          <p class="dispatches-sub">Peer-reviewed thinking on human psychology and daily decision systems.</p>
        </div>
        <div class="dispatches-count-badge">
          <%= posts.length %> Articles Published
        </div>
      </div>

      <!-- Clean Editorial Dispatches Table/Feed -->
      <div class="editorial-dispatches-feed">
        <% posts.forEach((post, idx) => { %>
          <article class="dispatch-item">
            <div class="dispatch-date-col">
              <time class="dispatch-date" datetime="<%= post.publishedAt %>"><%= post.publishedAt %></time>
              <span class="badge"><%= post.category %></span>
            </div>

            <div class="dispatch-body-col">
              <h3 class="dispatch-title">
                <a href="/post/<%= post.slug %>"><%= post.title %></a>
              </h3>

              <p class="dispatch-excerpt"><%= post.excerpt %></p>

              <div class="dispatch-meta-footer">
                <span class="dispatch-read-time">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <%= post.readingTime %>
                </span>

                <div class="dispatch-actions">
                  <button type="button" class="inline-save-btn" data-slug="<%= post.slug %>" data-title="<%= post.title %>" title="Save to reading list">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span>Save</span>
                  </button>

                  <a href="/post/<%= post.slug %>" class="dispatch-read-link">
                    <span>Read Essay</span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <!-- Dignified Editorial Newsletter Dispatch Box -->
      <div class="newsletter-editorial-box">
        <div class="newsletter-inner">
          <div class="newsletter-text-col">
            <span class="newsletter-kicker">WEEKLY INTELLIGENCE DISPATCH</span>
            <h3 class="newsletter-title">Subscribe to the EUREKA Letters</h3>
            <p class="newsletter-subtitle">
              Every Sunday morning, we synthesize one cognitive model or psychological study into an actionable 4-minute brief. Strictly zero advertisements or sponsor promotions.
            </p>
          </div>

          <div class="newsletter-form-col">
            <form id="newsletter-form" class="newsletter-form">
              <div class="newsletter-input-group">
                <input 
                  type="email" 
                  placeholder="name@organization.com" 
                  class="newsletter-input" 
                  aria-label="Email address"
                  required 
                />
                <button type="submit" class="newsletter-submit-btn">Subscribe</button>
              </div>
              <div class="newsletter-note">Private & confidential. Unsubscribe anytime with 1 click.</div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/scripts') %>
