<%- include('../partials/head') %>

<main class="page-404-container" style="padding: var(--space-16) 0 var(--space-24);">
  <div class="container" style="max-width: 760px; text-align: center;">
    <div style="display: inline-flex; align-items: center; gap: var(--space-2); padding: 4px 12px; border-radius: 9999px; background-color: var(--color-accent-subtle); color: var(--color-accent); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-6);">
      <span>404</span>
      <span>•</span>
      <span>Dispatch Not Located</span>
    </div>

    <h1 style="font-size: clamp(2rem, 5vw, 3.25rem); font-family: var(--font-serif); font-weight: 700; line-height: 1.2; margin-bottom: var(--space-4);">
      The page you were exploring has dissolved into the ether.
    </h1>

    <p style="font-size: var(--text-lg); color: var(--color-muted-foreground); max-width: 580px; margin: 0 auto var(--space-8); line-height: 1.6;">
      The essay or resource you requested may have been archived, reorganized, or never committed to our published registry.
    </p>

    <!-- Inline Search Bar for 404 Recovery -->
    <div style="max-width: 480px; margin: 0 auto var(--space-10);">
      <form action="/" method="GET" style="display: flex; gap: var(--space-2); width: 100%;" onsubmit="event.preventDefault(); window.EurekaApp && window.EurekaApp.openSearch ? window.EurekaApp.openSearch() : (window.location.href = '/');">
        <input 
          type="text" 
          placeholder="Search psychology, quantum physics, behavior..." 
          style="flex: 1; padding: 12px 16px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background-color: var(--color-card); color: var(--color-foreground); font-size: var(--text-sm);"
          id="notfound-search-input"
          onclick="window.EurekaApp && window.EurekaApp.openSearch && window.EurekaApp.openSearch()"
        />
        <button type="button" class="btn btn-primary" onclick="window.EurekaApp && window.EurekaApp.openSearch && window.EurekaApp.openSearch()" style="padding: 12px 20px;">
          Search
        </button>
      </form>
    </div>

    <!-- Recommended Flagship Essays -->
    <div style="border-top: 1px solid var(--color-border); padding-top: var(--space-8); text-align: left;">
      <div style="font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted-foreground); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-4); text-align: center;">
        Recommended Flagship Reading
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4);">
        <a href="/post/attachment-is-not-proof-someone-is-good-for-you" style="display: block; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background-color: var(--color-card); text-decoration: none; color: inherit; transition: transform var(--transition-fast), border-color var(--transition-fast);" onmouseover="this.style.borderColor='var(--color-accent)'" onmouseout="this.style.borderColor='var(--color-border)'">
          <div style="font-size: var(--text-xs); color: var(--color-accent); font-weight: 600; text-transform: uppercase; margin-bottom: 4px;">Psychology & Relationships</div>
          <div style="font-weight: 700; font-size: var(--text-base); margin-bottom: 6px; font-family: var(--font-serif);">Attachment Is Not Proof Someone Is Good for You</div>
          <div style="font-size: var(--text-xs); color: var(--color-muted-foreground);">Exploring emotional intensity versus relational safety.</div>
        </a>

        <a href="/post/what-if-hogwarts-followed-quantum-physics" style="display: block; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background-color: var(--color-card); text-decoration: none; color: inherit; transition: transform var(--transition-fast), border-color var(--transition-fast);" onmouseover="this.style.borderColor='var(--color-accent)'" onmouseout="this.style.borderColor='var(--color-border)'">
          <div style="font-size: var(--text-xs); color: #0ea5e9; font-weight: 600; text-transform: uppercase; margin-bottom: 4px;">Science Explained</div>
          <div style="font-weight: 700; font-size: var(--text-base); margin-bottom: 6px; font-family: var(--font-serif);">What If Hogwarts Followed Quantum Physics?</div>
          <div style="font-size: var(--text-xs); color: var(--color-muted-foreground);">Re-imagining spells as wave function collapses and quantum entanglement.</div>
        </a>
      </div>

      <div style="text-align: center; margin-top: var(--space-8);">
        <a href="/" class="btn btn-secondary" style="padding: 10px 24px;">Return to Front Page</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/scripts') %>
